// Script for Boogie Wonderland File name:  boogiewonderland.ls2;

music "BoogieWonderland.mp3";

idle IDLEWHITE;

defmacro MAC1 {
from 0.0 to 2.0 count 4 do SOUNDPULSE on [RINGLET2, RINGLET3, RINGLET4, RINGLET5] speed 250 color RED; };

at 4.50 do OFF on PERIMETER; 


at 0.0 macro MAC1;

// [RINGLET2, RINGLET3, RINGLET4, RINGLET5];
//[RINGLET2, RINGLET3, RINGLET4, RINGLET5] speed 250 color RED; };


